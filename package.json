{
  "name": "animesenpai-platform",
  "version": "1.0.0",
  "private": true,
  "description": "AnimeSenpai — Full-Stack Anime Discovery, Tracking & Recommendation Platform",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "setup": "npm install --workspace=frontend && npm install --workspace=backend && npm run db:push --workspace=backend && npm run db:seed --workspace=backend",
    "dev": "concurrently -n \"FRONTEND,BACKEND\" -c \"cyan.bold,green.bold\" \"npm run dev --workspace=frontend\" \"npm run dev --workspace=backend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=frontend && npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:pages": "npm run build --workspace=frontend",
    "deploy": "npm run deploy --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "start": "node backend/dist/server.js",
    "start:backend": "node backend/dist/server.js",
    "db:push": "npm run db:push --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "db:studio": "npm run db:studio --workspace=backend",
    "indexnow": "npm run indexnow --workspace=frontend",
    "lint": "npm run lint --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "prisma": "^6.19.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/node": "^22.13.9",
    "prisma": "^6.19.3",
    "typescript": "^5.8.2"
  }
}
